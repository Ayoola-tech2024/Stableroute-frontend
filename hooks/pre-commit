#!/usr/bin/env bash
# hooks/pre-commit
# ---------------------------------------------------------------------------
# StableRoute-frontend pre-commit guard.
#
# Two responsibilities, both opt-out-able:
#   1. Find-secret scan over staged files (scripts/check-staged-secrets.js)
#   2. Lint of staged .js/.jsx/.ts/.tsx files via `next lint <paths>`
#
# Opt-out environment variables (set in your shell, CI, or .envrc):
#   STABLEROUTE_SKIP_SECRET_SCAN=1   Skips ONLY the secret scanner
#   STABLEROUTE_SKIP_PRECOMMIT=1     Skips the entire hook (lint + scan)
#
# Maintainers, before bypassing during a real incident: ROTATE the leaked
# secret. Skipping the hook does not un-leak it.
# ---------------------------------------------------------------------------

set -euo pipefail

if [[ "${STABLEROUTE_SKIP_PRECOMMIT:-}" == "1" ]]; then
  echo "[pre-commit] SKIPPED — STABLEROUTE_SKIP_PRECOMMIT=1"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ---------------------------------------------------------------------------
# 1. Secret scan
# ---------------------------------------------------------------------------
if [[ "${STABLEROUTE_SKIP_SECRET_SCAN:-}" == "1" ]]; then
  echo "[pre-commit] secret scan SKIPPED — STABLEROUTE_SKIP_SECRET_SCAN=1"
else
  echo "[pre-commit] running secret scan…"
  if ! node "${REPO_ROOT}/scripts/check-staged-secrets.js"; then
    echo "[pre-commit] secret scan FAILED. See findings above."
    echo           "[pre-commit] To bypass in an emergency: STABLEROUTE_SKIP_SECRET_SCAN=1 git commit …"
    echo           "[pre-commit] NEVER commit a real secret — rotate it first."
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# 2. Lint staged JS/TS files only (fast, scoped)
#    We pass paths positionally to `next lint` rather than `--file` — Next
#    invoked through `npx` forwards args to ESLint and positional paths
#    round-trip cleanly through shell quoting (handles spaces).
# ---------------------------------------------------------------------------
mapfile -t STAGED_FILES < <(
  git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(js|jsx|ts|tsx)$' \
    || true
)

if [[ ${#STAGED_FILES[@]} -gt 0 ]]; then
  echo "[pre-commit] linting ${#STAGED_FILES[@]} staged JS/TS file(s):"
  printf '   • %s\n' "${STAGED_FILES[@]}"

  if ! npx --no-install next lint "${STAGED_FILES[@]}"; then
    echo "[pre-commit] lint FAILED on staged files."
    exit 1
  fi
else
  echo "[pre-commit] no staged JS/TS files to lint."
fi

echo "[pre-commit] OK"
exit 0
